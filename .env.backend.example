# ==============================================================================
# RescuOS - Backend Environment Template (Example)
# File: .env.backend.example
# Copy this file to .env.backend (or server/.env) and fill in your credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
FRONTEND_URL=http://localhost:5173

# Supabase Database & Auth Config
# (Provide actual credentials from your Supabase project dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Google Gemini API Config (Gemini 2.5 Flash for Real-Time Emergency Triage & Recommendations)
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
