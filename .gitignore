# ==============================================================================
# Git Ignore Rules for RescuOS (Smart Emergency Response System)
# Protects sensitive secrets, API keys, credentials, and build artifacts
# ==============================================================================

# 1. Environment & Secrets (CRITICAL: NEVER commit secrets or API keys to GitHub)
.env
.env.*
*.env
*.env.local
*.env.production
*.env.development
server/.env
server/.env.*
!.env.example
!*.env.example
!**/.env.example

# 2. Dependencies
node_modules/

# 3. Production Builds & TypeScript Artifacts
dist/
dist-ssr/
build/
*.tsbuildinfo
tsconfig.tsbuildinfo
.temp/

# 4. Logs and Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. IDE & System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
