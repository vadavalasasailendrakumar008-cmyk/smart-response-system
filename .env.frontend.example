# ==============================================================================
# RescuOS - Frontend Environment Template (Example)
# File: .env.frontend.example
# Copy this file to .env.frontend (or .env) and set your variables.
# Note: All client-accessible variables MUST start with the VITE_ prefix.
# ==============================================================================

# Frontend Dev Server Port
VITE_PORT=5173

# Backend REST & SSE API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Supabase Client Configuration
# (Provide if connecting directly from client via Supabase SDK)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
